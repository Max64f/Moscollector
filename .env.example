POSTGRES_USER=ldt
POSTGRES_PASSWORD=ldt
POSTGRES_DB=moscollector
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://ldt:ldt@db:5432/moscollector

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Каталог с CSV журналами и справочниками (не коммитить).
# Локально: относительный путь от корня репозитория.
DATA_DIR=../dataset
PARQUET_DIR=../dataset/parquet

# Потоки OpenMP/LightGBM в контейнере ml (чтение Parquet + 4 модели параллельно).
LGBM_THREADS=8
